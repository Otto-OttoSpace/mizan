{
  "name": "@ottospace/mizan",
  "version": "0.2.0",
  "description": "Mizan — an open, reproducible benchmark harness for right-to-left / Arabic correctness in code, graded by the Otto RTL toolchain (miraat + kashida + daleel). Ships reference fixtures; not a scoreboard of named tools.",
  "bin": {
    "mizan": "score.js"
  },
  "main": "score.js",
  "type": "commonjs",
  "scripts": {
    "score": "node score.js",
    "test": "node --test"
  },
  "keywords": [
    "mizan",
    "rtl-arena",
    "rtl",
    "right-to-left",
    "arabic",
    "i18n",
    "benchmark",
    "ai-coding-tools",
    "accessibility"
  ],
  "files": [
    "score.js",
    "prompts.md",
    "outputs",
    "README.md",
    "LICENSE"
  ],
  "author": "Otto (Othmane Morad)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Otto-OttoSpace/mizan.git"
  },
  "engines": {
    "node": ">=18"
  },
  "funding": {
    "type": "polar",
    "url": "https://polar.sh/otto-space"
  },
  "publishConfig": {
    "access": "public"
  }
}
